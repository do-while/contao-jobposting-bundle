{
    "name": "do-while/contao-jobposting-bundle",
    "description": "JobPosting Markup Generator",
    "keywords": ["contao", "contentelement", "jobposting", "google-for-jobs", "jobs"],
    "type": "contao-bundle",
    "homepage": "https://www.softleister.de",
    "license": "LGPL-3.0+",
    "authors": [{
        "name": "Softleister - Hagen Klemp",
        "homepage": "https://www.softleister.de",
        "role": "Developer"
    }],
    "support": {
        "issues": "https://github.com/do-while/contao-jobposting-bundle/issues",
        "source": "https://github.com/do-while/contao-jobposting-bundle"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "Softleister\\JobpostingBundle\\": "src/"
        },
        "classmap": [
            "contao/"
        ],
        "exclude-from-classmap": [
            "contao/config/",
            "contao/dca/",
            "contao/languages/",
            "contao/templates/"
        ]
    },
    "extra": {
		"contao-manager-plugin": "Softleister\\JobpostingBundle\\ContaoManager\\Plugin"
    }
}
